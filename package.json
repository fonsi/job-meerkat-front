{
    "name": "jobmeerkat-front",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "copyEnv:dev": "cp .env.dev .env.local",
        "copyEnv:prod": "cp .env.prod .env.local",
        "cleanCache": "rm -rf .next .output out",
        "dev": "npm run copyEnv:dev && vite dev",
        "build:dev": "npm run cleanCache && npm run copyEnv:dev && vite build && node scripts/generate-sitemap.js && node scripts/generate-ads-txt.js",
        "build:prod": "npm run cleanCache && npm run copyEnv:prod && vite build && node scripts/generate-sitemap.js && node scripts/generate-ads-txt.js",
        "start": "node .output/server/index.mjs",
        "lint": "eslint .",
        "deploy:dev": "npm run build:dev && ./scripts/copy-to-S3.sh",
        "deploy:prod": "npm run build:prod && ./scripts/copy-to-S3.sh",
        "prepare": "husky",
        "typecheck": "tsc --noEmit",
        "pre-commit": "lint-staged && npm run typecheck && npm test",
        "test": "jest"
    },
    "dependencies": {
        "@tanstack/react-router": "^1.168.10",
        "@tanstack/react-router-devtools": "^1.166.11",
        "@tanstack/react-start": "^1.167.16",
        "@tanstack/router-plugin": "^1.167.12",
        "p-retry": "^6.2.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "styled-components": "^6.1.19"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@swc/plugin-styled-components": "^12.7.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.6.4",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^29.5.14",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react-swc": "^4.3.0",
        "dotenv": "^16.5.0",
        "eslint": "^9",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "lint-staged": "^16.1.2",
        "prettier": "^3.6.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "typescript": "^5",
        "typescript-eslint": "^8.58.0",
        "vite": "^8.0.8"
    },
    "lint-staged": {
        "*.{js,ts,jsx,tsx,mjs,json}": "prettier --list-different --write"
    }
}
